[Script]
# 1. Fake Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/akaphuoc28/Module_IOS/refs/heads/main/js/Locket_akaphuoc28.js, requires-body=true, max-size=-1, timeout=60

# 2. Xóa Header
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/akaphuoc28/Module_IOS/refs/heads/main/js/deleteHeader.js, timeout=60

# 3. Cấu hình Caption (Chạy trước)
locket_caption = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.*, script-path=https://raw.githubusercontent.com/akaphuoc28/Module_IOS/refs/heads/main/js/caption_config.js, requires-body=true, max-size=-1, timeout=60

# 4. Cấu hình Photobooth (Chạy sau, nối tiếp cấu hình Caption)
locket_photobooth = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/.*, script-path=https://raw.githubusercontent.com/akaphuoc28/Module_IOS/refs/heads/main/js/locket_photobooth.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com
